# Google Sheets — stores beta signups
GOOGLE_SERVICE_ACCOUNT_EMAIL=beta-signups@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_SHEET_ID=your-sheet-id-from-url

# Resend — email notifications on new signups
RESEND_API_KEY=re_your_api_key
RESEND_FROM=onboarding@resend.dev  # optional: use your verified domain

# Notification recipients (comma-separated)
NOTIFY_EMAILS=alice@example.com,bob@example.com
